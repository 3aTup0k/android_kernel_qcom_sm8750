&adsp_loader {
	status = "ok";
};

&lpi_tlmm {
	spkr_02_sd_n {

		lpi_spkr_02_sd_n_sleep: spkr_02_sd_n_sleep {

			mux {
				function = "gpio";
				pins = "gpio17";
			};

			config {
				input-enable;
				bias-pull-down;
				drive-strength = <0x02>;
				pins = "gpio17";
			};
		};

		lpi_spkr_02_sd_n_active: spkr_02_sd_n_active {

			mux {
				function = "gpio";
				pins = "gpio17";
			};

			config {
				output-high;
				bias-disable;
				drive-strength = <0x10>;
				pins = "gpio17";
			};
		};
	};

	spkr_13_sd_n {

		lpi_spkr_13_sd_n_sleep: spkr_13_sd_n_sleep {

			mux {
				function = "gpio";
				pins = "gpio18";
			};

			config {
				input-enable;
				bias-pull-down;
				drive-strength = <0x02>;
				pins = "gpio18";
			};
		};

		lpi_spkr_13_sd_n_active: spkr_13_sd_n_active {

			mux {
				function = "gpio";
				pins = "gpio18";
			};

			config {
				output-high;
				bias-disable;
				drive-strength = <0x10>;
				pins = "gpio18";
			};
		};
	};
};

&soc {
	sbu_uart_en: msm_cdc_pinctrl@60 {
		#gpio-cells = <0x00>;
		pinctrl-1 = <&sbu_uart_en_idle>;
		pinctrl-0 = <&sbu_uart_en_active>;
		pinctrl-names = "aud_active", "aud_sleep";
		compatible = "qcom,msm-cdc-pinctrl";
	};
};

&lpass_cdc {
	qcom,num-macros = <0x05>;
};

&qupv3_hub_i2c0 {
	status = "ok";

	cs35l43_0: cs35l43@40 {
		cirrus,vpbr-thld = <0x04>;
		cirrus,vpbr-max-att = <0x06>;
		cirrus,vpbr-atk-vol = <0x05>;
		cirrus,vpbr-atk-rate = <0x00>;
		cirrus,vpbr-wait = <0x00>;
		cirrus,vpbr-rel-rate = <0x00>;
		cirrus,vpbr-enable = <0x01>;
		cirrus,low-pwr-mode-standby = <0x01>;
		cirrus,i2c-addr = <0x28>;
		sound-name-prefix = "B";
		cirrus,gpio2-src-sel = <0x04>;
		cirrus,asp-sdout-hiz = <0x03>;
		cirrus,bst-ipk-ma = <4000>;
		pinctrl-0 = <&cirrus_reset_default_0 &cirrus_irq_default_0>;
		pinctrl-names = "default";
		interrupts = <0x54 0x2008>;
		interrupt-parent = <&tlmm>;
		reg = <0x40>;
		reset-gpios = <&tlmm 0x6b 0x00>;
		compatible = "cirrus,cs35l43";
		status = "ok";
	};

	cs35l43_1: cs35l43@42 {
		cirrus,vpbr-thld = <0x04>;
		cirrus,vpbr-max-att = <0x06>;
		cirrus,vpbr-atk-vol = <0x05>;
		cirrus,vpbr-atk-rate = <0x00>;
		cirrus,vpbr-wait = <0x00>;
		cirrus,vpbr-rel-rate = <0x00>;
		cirrus,vpbr-enable = <0x01>;
		cirrus,low-pwr-mode-standby = <0x01>;
		cirrus,i2c-addr = <0x2a>;
		sound-name-prefix = "T";
		cirrus,gpio2-src-sel = <0x04>;
		cirrus,asp-sdout-hiz = <0x03>;
		cirrus,bst-ipk-ma = <4000>;
		pinctrl-2 = <&rcv_gpio_low>;
		pinctrl-1 = <&rcv_gpio_high>;
		pinctrl-0 = <&cirrus_reset_default_1 &cirrus_irq_default_1>;
		pinctrl-names = "default", "rcv_gpio_high", "rcv_gpio_low";
		interrupts = <0x42 0x2008>;
		interrupt-parent = <&tlmm>;
		reg = <0x42>;
		reset-gpios = <&tlmm 0x6c 0x00>;
		compatible = "cirrus,cs35l43";
		status = "ok";
	};
};

&wcd_usbss {
	pinctrl-1 = <&wcd_usbss_reset_sleep>;
	pinctrl-0 = <&wcd_usbss_reset_active>;
	pinctrl-names = "usbss_active", "usbss_sleep";
	reset-gpios = <&tlmm 0x98 0x00>;
};

&tlmm {
	cirrus_reset_default_0: cirrus_reset_default_0 {

		mux {
			function = "gpio";
			pins = "gpio107";
		};

		config {
			output-high;
			bias-disable;
			drive-strength = <0x10>;
			pins = "gpio107";
		};
	};

	cirrus_reset_default_1: cirrus_reset_default_1 {

		mux {
			function = "gpio";
			pins = "gpio108";
		};

		config {
			output-high;
			bias-disable;
			drive-strength = <0x10>;
			pins = "gpio108";
		};
	};

	cirrus_irq_default {

		cirrus_irq_default_0: cirrus_irq_default_0 {

			mux {
				function = "gpio";
				pins = "gpio84";
			};

			config {
				bias-pull-up;
				input-enable;
				drive-strength = <0x02>;
				pins = "gpio84";
			};
		};

		cirrus_irq_default_1: cirrus_irq_default_1 {

			mux {
				function = "gpio";
				pins = "gpio66";
			};

			config {
				bias-pull-up;
				input-enable;
				drive-strength = <0x02>;
				pins = "gpio66";
			};
		};
	};

	wcd_usbss_reset_active: wcd_usbss_reset_active {

		mux {
			function = "gpio";
			pins = "gpio152";
		};

		config {
			output-high;
			drive-strength = <0x10>;
			pins = "gpio152";
		};
	};

	wcd_usbss_reset_sleep: wcd_usbss_reset_sleep {

		mux {
			function = "gpio";
			pins = "gpio152";
		};

		config {
			output-low;
			bias-disable;
			drive-strength = <0x10>;
			pins = "gpio152";
		};
	};

	rcv_gpio_high: rcv_gpio_high {

		mux {
			function = "gpio";
			pins = "gpio67";
		};

		config {
			output-high;
			bias-pull-up;
			drive-strength = <0x02>;
			pins = "gpio67";
		};
	};

	rcv_gpio_low: rcv_gpio_low {

		mux {
			function = "gpio";
			pins = "gpio67";
		};

		config {
			output-low;
			bias-disable;
			drive-strength = <0x02>;
			pins = "gpio67";
		};
	};

	sbu_uart_en_ctrl {

		sbu_uart_en_idle: uart_audio_en_idle {

			mux {
				function = "gpio";
				pins = "gpio60";
			};

			config {
				output-low;
				bias-pull-down;
				drive-strength = <0x02>;
				pins = "gpio60";
			};
		};

		sbu_uart_en_active: uart_audio_en_active {

			mux {
				function = "gpio";
				pins = "gpio60";
			};

			config {
				output-high;
				bias-disable;
				drive-strength = <0x02>;
				pins = "gpio60";
			};
		};
	};

	tdm1_clk_sleep: tdm1_clk_sleep {

		mux {
			function = "gpio";
			pins = "gpio121";
		};

		config {
			input-enable;
			bias-pull-down;
			drive-strength = <0x02>;
			pins = "gpio121";
		};
	};

	tdm1_clk_active: tdm1_clk_active {

		mux {
			function = "i2s1_sck";
			pins = "gpio121";
		};

		config {
			output-high;
			bias-disable;
			drive-strength = <0x08>;
			pins = "gpio121";
		};
	};

	tdm1_ws_sleep: tdm1_ws_sleep {

		mux {
			function = "gpio";
			pins = "gpio123";
		};

		config {
			input-enable;
			bias-pull-down;
			drive-strength = <0x02>;
			pins = "gpio123";
		};
	};

	tdm1_ws_active: tdm1_ws_active {

		mux {
			function = "i2s1_ws";
			pins = "gpio123";
		};

		config {
			output-high;
			bias-disable;
			drive-strength = <0x06>;
			pins = "gpio123";
		};
	};

	tdm1_din_sleep: tdm1_din_sleep {

		mux {
			function = "gpio";
			pins = "gpio122";
		};

		config {
			input-enable;
			bias-pull-down;
			drive-strength = <0x02>;
			pins = "gpio122";
		};
	};

	tdm1_din_active: tdm1_din_active {

		mux {
			function = "i2s1_data0";
			pins = "gpio122";
		};

		config {
			bias-disable;
			drive-strength = <0x08>;
			pins = "gpio122";
		};
	};

	tdm1_dout_sleep: tdm1_dout_sleep {

		mux {
			function = "gpio";
			pins = "gpio124";
		};

		config {
			input-enable;
			bias-pull-down;
			drive-strength = <0x02>;
			pins = "gpio124";
		};
	};

	tdm1_dout_active: tdm1_dout_active {

		mux {
			function = "i2s1_data1";
			pins = "gpio124";
		};

		config {
			bias-disable;
			drive-strength = <0x08>;
			pins = "gpio124";
		};
	};
};

&lpass_bt_swr {
	status = "ok";
};
